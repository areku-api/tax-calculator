{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "taxi-chi-seven.vercel.app" }],
      "destination": "https://donkeebaat.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "donkeebaat.vercel.app" }],
      "destination": "https://donkeebaat.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
